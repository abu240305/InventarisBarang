<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventarisBarang"
        android:usesCleartextTraffic="true">

        <!-- Splash / Main Dispatcher (Optional) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Login (LAUNCHER) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false" />

        <!-- Barang -->
        <activity
            android:name=".ui.barang.DaftarBarangActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.barang.TambahBarangActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.barang.DetailBarangActivity"
            android:exported="false" />
        <activity
            android:name=".ui.barang.EditBarangActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Peminjaman -->
        <activity
            android:name=".ui.peminjaman.DaftarPeminjamanActivity"
            android:exported="false" />
        <activity
            android:name=".ui.peminjaman.TambahPeminjamanActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.peminjaman.DetailPeminjamanActivity"
            android:exported="false" />

        <!-- Kategori -->
        <activity
            android:name=".ui.kategori.KategoriActivity"
            android:exported="false" />

        <!-- Profil -->
        <activity
            android:name=".ui.profil.ProfilActivity"
            android:exported="false" />

        <!-- Pengguna -->
        <activity
            android:name=".ui.pengguna.KelolaPenggunaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Scan Barcode Modern Screen -->
        <activity
            android:name=".ui.scan.ScanBarcodeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
