<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Tambah Barang Baru"
            app:titleTextColor="@color/white"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="48dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 1. KODE BARANG (DENGAN SCAN AUTO-FILL) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KODE BARANG (SKU) "
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_input_bg">

                        <EditText
                            android:id="@+id/etKodeBarang"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:hint="misal: BRG-001"
                            android:inputType="textCapCharacters"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="48dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/btnScanKodeBarang"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="10dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Scan Barcode"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/ic_scan"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <!-- 2. NAMA BARANG -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NAMA BARANG "
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etNamaBarang"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_input_bg"
                        android:hint="Masukkan nama perangkat / barang"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- 3. KATEGORI BARANG (Modern Clickable Selector) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="KATEGORI BARANG"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <FrameLayout
                        android:id="@+id/btnSelectKategori"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_input_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tvSelectedKategori"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="42dp"
                            android:text="Pilih kategori barang..."
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp" />

                        <ImageView
                            android:id="@+id/ivChevronKategori"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </FrameLayout>

                    <!-- 4. STEPPER JUMLAH STOK (- / +) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JUMLAH STOK UNIT "
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_input_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnMinusStok"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="—"
                            android:textColor="#64748B"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etStok"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="number"
                            android:text="1"
                            android:textColor="#1E293B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnPlusStok"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#64748B"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 5. LOKASI RAK GUDANG -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOKASI RAK GUDANG"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etLokasiRak"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_input_bg"
                        android:hint="misal: Rak A-01 / Lemari IT"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- 6. 3 RADIO CARDS KONDISI FISIK (Baik, Rusak Ringan, Rusak Berat) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="KONDISI FISIK BARANG"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Kondisi 1: Baik -->
                        <LinearLayout
                            android:id="@+id/btnKondisiBaik"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/form_kondisi_selected_bg"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/circle_icon_bg"
                                android:backgroundTint="@color/secondary" />

                            <TextView
                                android:id="@+id/tvKondisiBaik"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Baik"
                                android:textColor="#1E293B"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Kondisi 2: Rusak Ringan -->
                        <LinearLayout
                            android:id="@+id/btnKondisiPerbaikan"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.2"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/form_kondisi_unselected_bg"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/circle_icon_bg"
                                android:backgroundTint="@color/tertiary" />

                            <TextView
                                android:id="@+id/tvKondisiPerbaikan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Rusak Ringan"
                                android:textColor="#64748B"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Kondisi 3: Rusak Berat -->
                        <LinearLayout
                            android:id="@+id/btnKondisiRusak"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.2"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/form_kondisi_unselected_bg"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/circle_icon_bg"
                                android:backgroundTint="@color/error" />

                            <TextView
                                android:id="@+id/tvKondisiRusak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Rusak Berat"
                                android:textColor="#64748B"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 7. IMAGE PICKER FOTO BARANG (KAMERA / GALERI) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="FOTO BARANG / ASET"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/btnToggleUrlMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Input via URL?"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:padding="4dp" />
                    </LinearLayout>

                    <!-- Modern Image Picker Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPickImage"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginTop="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardBackgroundColor="#EFF4FF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#C7D7FE"
                        app:strokeWidth="1.2dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <!-- Placeholder View (Before image selected) -->
                            <LinearLayout
                                android:id="@+id/layoutImagePlaceholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:background="@drawable/circle_icon_bg"
                                    android:backgroundTint="#DBEAFE"
                                    android:padding="8dp"
                                    android:src="@drawable/ic_gallery"
                                    app:tint="@color/primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Pilih Foto Barang (Galeri / Kamera)"
                                    android:textColor="@color/primary"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="JPG, PNG maks 5MB"
                                    android:textColor="@color/text_muted"
                                    android:textSize="10.5sp" />
                            </LinearLayout>

                            <!-- Preview View (After image selected) -->
                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPreviewFoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                            <!-- Change badge over preview -->
                            <TextView
                                android:id="@+id/tvChangeImageBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/pill_badge"
                                android:backgroundTint="#B3000000"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Ganti Foto ✎"
                                android:textColor="@color/white"
                                android:textSize="10.5sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- URL Input Box (Hidden by default, shown via toggle) -->
                    <LinearLayout
                        android:id="@+id/layoutUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/etGambarUrl"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/form_input_bg"
                            android:hint="https://... atau URL foto aset"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:paddingHorizontal="14dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="#94A3B8"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <!-- 8. DESKRIPSI -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="DESKRIPSI (opsional)"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <EditText
                        android:id="@+id/etDeskripsi"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/form_input_bg"
                        android:gravity="top|start"
                        android:hint="Deskripsi lengkap atau spesifikasi barang (Opsional)"
                        android:inputType="textMultiLine"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:visibility="gone" />

                    <!-- SIMPAN BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSimpan"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="22dp"
                        android:text="Simpan Barang"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>